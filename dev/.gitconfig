[user]
	name = Jose Maria
	email = josemagomez.devs@gmail.com
	username = josego16
	signingKey = ~/.ssh/id_ed25519.pub

[core]
	editor = zed
	excludesFile = ~/.gitignore
	pager = less -FXR
	whitespace = trailing-space,space-before-tab

[gpg]
	format = ssh

[pull]
	rebase = true

[fetch]
	prune = true

[rebase]
	autoStash = true
	autosquash = true
	updateRefs = true

[push]
	useForceIfIncludes = true
	autoSetupRemote = true

[commit]
	verbose = true
	gpgsign = true

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	colorMoved = zebra

[merge]
	conflictStyle = zdiff3

[log]
	date = relative

[status]
	showUntrackedFiles = all

[interactive]
	singleKey = true

[tag]
	sort = version:refname

[help]
	autocorrect = prompt

[url "git@github.com:"]
	insteadOf = https://github.com/

[init]
	defaultBranch = main
